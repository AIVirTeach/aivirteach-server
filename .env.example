PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3001
COURSE_DATA_PATH="/absolute/path/to/course data"

# Learner-to-VM assignments are owned by this backend. Keep this JSON server-side.
LEARNER_LAB_MAP='{"learner_advanced":"lab-001"}'
LABS_API_BASE_URL=http://127.0.0.1:8760
LABS_SESSION_TOKEN=replace-with-the-labs-browser-session-token
GUACAMOLE_PUBLIC_PATH=/guacamole/

# This value must match AIVIRTEACH_AGENT_TOKEN on the private Labs Agent service.
LABS_AGENT_BASE_URL=http://127.0.0.1:8770
LABS_AGENT_TOKEN=replace-with-the-labs-agent-token
LABS_AGENT_TIMEOUT_MS=45000
LABS_AGENT_WORKSPACE_ROOT=/home/learner/course

# Omit DATABASE_URL to use the in-memory fallback.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/aivirteach?schema=public
