# Database (required to bring /health's "database" check to "up")
DATABASE_URL="postgresql://user:password@localhost:5432/aivirteach?schema=public"

# Auth — Clerk (leave unset to boot with auth disabled; protected routes return 503)
CLERK_SECRET_KEY=

# Billing — Stripe (leave unset to boot with billing disabled; webhook returns 503)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PORT=3000
